{%- comment -%}
  Renders a single product card.
  Accepts: product (product object)
{%- endcomment -%}

{%- liquid
  assign card_image = product.featured_image
  assign hover_image = product.media[1]
  assign current_variant = product.selected_or_first_available_variant
  assign is_single_variant = false
  if product.variants.size == 1
    assign is_single_variant = true
  endif
-%}

<div class="product-card">
  <div class="product-card__media-wrap">
    {%- if product.tags contains 'New' -%}
      <span class="product-card__badge">New</span>
    {%- endif -%}

    <a href="{{ product.url }}" class="product-card__media-link" aria-label="{{ product.title | escape }}">
      {%- if card_image != blank -%}
        <img
          src="{{ card_image | image_url: width: 800 }}"
          srcset="
            {{ card_image | image_url: width: 400 }} 400w,
            {{ card_image | image_url: width: 600 }} 600w,
            {{ card_image | image_url: width: 800 }} 800w
          "
          sizes="(min-width: 1200px) 25vw, (min-width: 750px) 50vw, 100vw"
          width="{{ card_image.width }}"
          height="{{ card_image.height }}"
          loading="lazy"
          alt="{{ card_image.alt | default: product.title | escape }}"
          class="product-card__img product-card__img--primary"
        >
      {%- else -%}
        <div class="product-card__img product-card__img--placeholder"></div>
      {%- endif -%}

      {%- if hover_image != blank -%}
        <img
          src="{{ hover_image | image_url: width: 800 }}"
          srcset="
            {{ hover_image | image_url: width: 400 }} 400w,
            {{ hover_image | image_url: width: 600 }} 600w,
            {{ hover_image | image_url: width: 800 }} 800w
          "
          sizes="(min-width: 1200px) 25vw, (min-width: 750px) 50vw, 100vw"
          width="{{ hover_image.width }}"
          height="{{ hover_image.height }}"
          loading="lazy"
          alt=""
          aria-hidden="true"
          class="product-card__img product-card__img--hover"
        >
      {%- endif -%}
    </a>

    <div class="product-card__quick-add-wrap">
      {%- if is_single_variant and current_variant.available? -%}
        {%- form 'product', product, class: 'product-card__quick-add-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <button
            type="submit"
            class="product-card__quick-add-btn"
            data-quick-add-btn
          >
            <span class="product-card__quick-add-text">Quick Add</span>
            <span class="material-symbols-outlined product-card__quick-add-icon" hidden>check</span>
          </button>
        {%- endform -%}
      {%- elsif current_variant.available? -%}
        <a href="{{ product.url }}" class="product-card__quick-add-btn product-card__quick-add-btn--link">
          <span class="product-card__quick-add-text">Quick Add</span>
        </a>
      {%- else -%}
        <span class="product-card__quick-add-btn product-card__quick-add-btn--soldout"> Sold Out </span>
      {%- endif -%}
    </div>
  </div>

  <a href="{{ product.url }}" class="product-card__info">
    <h3 class="product-card__title">{{ product.title | escape }}</h3>
    <span class="product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
        <span class="product-card__price-sale">{{ product.price | money }}</span>
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
    </span>
  </a>
</div>
