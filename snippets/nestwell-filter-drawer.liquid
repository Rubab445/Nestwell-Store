{% comment %}
  Renders the slide-in filter drawer. Uses collection.filters, which Shopify
  populates from variant options (Color) and filterable metafields (Material),
  plus native price/availability filters.
{% endcomment %}

<div class="nestwell-filter-drawer" data-filter-drawer aria-hidden="true">
  <div class="nestwell-filter-drawer__overlay" data-filter-close></div>

  <div class="nestwell-filter-drawer__panel" role="dialog" aria-label="Filter products">
    <div class="nestwell-filter-drawer__header">
      <h2 class="nestwell-filter-drawer__title">Filter</h2>
      <button type="button" class="nestwell-filter-drawer__close" data-filter-close aria-label="Close filters">
        &times;
      </button>
    </div>

    <form id="nestwell-filter-form" class="nestwell-filter-drawer__form">
      {% for filter in collection.filters %}
        <div class="nestwell-filter-group" data-filter-group="{{ filter.param_name }}">
          <h3 class="nestwell-filter-group__title">{{ filter.label }}</h3>

          {% case filter.type %}
            {% when 'list' %}
              <ul class="nestwell-filter-group__list">
                {% for value in filter.values %}
                  <li class="nestwell-filter-option">
                    <label class="nestwell-filter-option__label">
                      <input
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value }}"
                        data-filter-input
                        {% if value.active %}
                          checked
                        {% endif %}
                        {% if value.count == 0 and value.active == false %}
                          disabled
                        {% endif %}
                      >
                      <span>{{ value.label }}</span>
                      <span class="nestwell-filter-option__count">({{ value.count }})</span>
                    </label>
                  </li>
                {% endfor %}
              </ul>

            {% when 'price_range' %}
              <div class="nestwell-filter-price">
                <label class="nestwell-filter-price__field">
                  <span>Min</span>
                  <input
                    type="number"
                    name="{{ filter.min_value.param_name }}"
                    value="{{ filter.min_value.value }}"
                    placeholder="{{ filter.range_min | money_without_currency }}"
                    data-filter-input
                    data-filter-debounce
                  >
                </label>
                <label class="nestwell-filter-price__field">
                  <span>Max</span>
                  <input
                    type="number"
                    name="{{ filter.max_value.param_name }}"
                    value="{{ filter.max_value.value }}"
                    placeholder="{{ filter.range_max | money_without_currency }}"
                    data-filter-input
                    data-filter-debounce
                  >
                </label>
              </div>

            {% when 'boolean' %}
              <label class="nestwell-filter-option__label">
                <input
                  type="checkbox"
                  name="{{ filter.param_name }}"
                  value="1"
                  data-filter-input
                  {% if filter.active_values.size > 0 %}
                    checked
                  {% endif %}
                >
                <span>{{ filter.label }}</span>
              </label>
          {% endcase %}
        </div>
      {% endfor %}

      <div class="nestwell-filter-drawer__actions">
        <button type="button" class="nestwell-filter-drawer__clear" data-filter-clear>Clear all</button>
        <button type="submit" class="nestwell-filter-drawer__apply">Apply</button>
      </div>
    </form>
  </div>
</div>
