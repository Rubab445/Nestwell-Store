<section class="nestwell-about-hero" id="nestwell-about-hero-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="nestwell-about-hero__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        srcset="
          {{ section.settings.image | image_url: width: 800 }} 800w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1800 }} 1800w,
          {{ section.settings.image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        alt=""
        class="nestwell-about-hero__img"
        data-parallax-img
      >
    {%- endif -%}
    <div class="nestwell-about-hero__overlay"></div>
  </div>

  <div class="nestwell-about-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="nestwell-about-hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafting Sanctuaries of Serenity and Tactile Luxury"
    }
  ],
  "presets": [{ "name": "About Hero" }]
}
{% endschema %}

{% stylesheet %}
  .nestwell-about-hero {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .nestwell-about-hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .nestwell-about-hero__img {
    position: absolute;
    top: -10%;
    left: 0;
    width: 100%;
    height: 120%;
    object-fit: cover;
    will-change: transform;
  }
  .nestwell-about-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.2);
  }
  .nestwell-about-hero__content {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    width: 100%;
    padding: 0 20px;
    text-align: center;
  }
  @media screen and (min-width: 990px) {
    .nestwell-about-hero__content {
      padding: 0 64px;
    }
  }
  .nestwell-about-hero__title {
    margin: 0;
    font-family: 'EB Garamond', serif;
    font-size: 40px;
    line-height: 48px;
    letter-spacing: -0.01em;
    color: #ffffff;
    animation: nestwellHeroFadeUp 1s ease-out forwards;
    opacity: 0;
    transform: translateY(24px);
  }
  @media screen and (min-width: 990px) {
    .nestwell-about-hero__title {
      font-size: 64px;
      line-height: 72px;
    }
  }
  @keyframes nestwellHeroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nestwell-about-hero__title {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .nestwell-about-hero__img {
      transform: none !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('.nestwell-about-hero[data-section-id]');
    if (!section) return;

    var parallaxImg = section.querySelector('[data-parallax-img]');
    if (!parallaxImg) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var ticking = false;

    function updateParallax() {
      var rect = section.getBoundingClientRect();
      var viewportHeight = window.innerHeight;

      if (rect.bottom < 0 || rect.top > viewportHeight) {
        ticking = false;
        return;
      }

      var progress = (viewportHeight - rect.top) / (viewportHeight + rect.height);
      var offset = (progress - 0.5) * 60;

      parallaxImg.style.transform = 'translateY(' + offset + 'px)';
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    onScroll();
  });
{% endjavascript %}
