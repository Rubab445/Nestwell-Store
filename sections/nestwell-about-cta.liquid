<section class="nestwell-about-cta" id="nestwell-about-cta-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="nestwell-about-cta__content observe-fade-up">
    {%- if section.settings.heading != blank -%}
      <h2 class="nestwell-about-cta__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="nestwell-about-cta__button">
        {{ section.settings.button_label | escape }}
        <span class="nestwell-about-cta__arrow">{% render 'icon-arrow-forward' %}</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Begin Building Your Sanctuary" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Return to Collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "About CTA" }]
}
{% endschema %}

{% stylesheet %}
  .nestwell-about-cta {
    width: 100%;
    background: #171916;
    padding: 96px 20px;
    text-align: center;
  }
  .nestwell-about-cta__heading {
    margin: 0 0 32px;
    font-family: var(--font-heading-family);
    font-size: 40px;
    line-height: 48px;
    color: #ffffff;
  }
  @media screen and (min-width: 990px) {
    .nestwell-about-cta__heading {
      font-size: 64px;
      line-height: 72px;
    }
  }
  .nestwell-about-cta__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    color: #171916;
    padding: 16px 32px;
    font-family: var(--font-body-family);
    font-size: 12px;
    letter-spacing: 0.1em;
    font-weight: 600;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }
  .nestwell-about-cta__button:hover {
    background: #efeeec;
  }
  .nestwell-about-cta__arrow {
    font-size: 6px;
  }

  
{% endstylesheet %}


