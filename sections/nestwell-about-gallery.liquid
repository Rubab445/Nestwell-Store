<section class="nestwell-about-gallery" id="nestwell-about-gallery-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="nestwell-about-gallery__strip">
    {%- for block in section.blocks -%}
      {%- if block.type == 'photo' -%}
        <div class="nestwell-about-gallery__item observe-fade-up" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- assign photo_alt = block.settings.alt | default: block.settings.image.alt -%}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              srcset="
                {{ block.settings.image | image_url: width: 600 }} 600w,
                {{ block.settings.image | image_url: width: 900 }} 900w,
                {{ block.settings.image | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 990px) 30vw, 70vw"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              alt="{{ photo_alt | escape }}"
              class="nestwell-about-gallery__img"
            >
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "About Photo Strip",
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Describe what's shown — these images have no adjacent caption, so this is the only accessible description of the content."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Photo Strip",
      "blocks": [{ "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .nestwell-about-gallery {
    width: 100%;
    padding: 120px 0;
    overflow: hidden;
  }
  .nestwell-about-gallery__strip {
    display: flex;
    gap: 16px;
    padding: 0 20px 32px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  @media screen and (min-width: 990px) {
    .nestwell-about-gallery__strip {
      padding: 0 64px 32px;
    }
  }
  .nestwell-about-gallery__strip::-webkit-scrollbar {
    display: none;
  }
  .nestwell-about-gallery__item {
    min-width: 70vw;
    height: 50vh;
    scroll-snap-align: center;
    box-shadow: 0 12px 32px rgba(23, 25, 22, 0.1);
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.8s ease;
  }
  @media screen and (min-width: 768px) {
    .nestwell-about-gallery__item {
      min-width: 40vw;
    }
  }
  @media screen and (min-width: 990px) {
    .nestwell-about-gallery__item {
      min-width: 30vw;
    }
  }
  .nestwell-about-gallery__item:hover {
    transform: scale(1.03);
  }
  .nestwell-about-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .observe-fade-up {
    opacity: 0;
    transform: translateY(24px);
  }
  .observe-fade-up.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .observe-fade-up {
      transition: none;
      opacity: 1;
      transform: none;
    }
    .nestwell-about-gallery__item:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('.nestwell-about-gallery[data-section-id]');
    if (!section) return;

    var targets = section.querySelectorAll('.observe-fade-up');
    if (!targets.length) return;

    if (!('IntersectionObserver' in window)) {
      targets.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries, obs) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    targets.forEach(function (el) {
      observer.observe(el);
    });
  });
{% endjavascript %}
