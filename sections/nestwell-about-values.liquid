<section class="nestwell-about-values" id="nestwell-about-values-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="nestwell-about-values__intro observe-fade-up">
    {%- if section.settings.eyebrow != blank -%}
      <span class="nestwell-about-values__eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="nestwell-about-values__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </div>

  <div class="nestwell-about-values__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'value' -%}
        <div
          class="nestwell-about-values__card observe-scale-in"
          style="transition-delay: {{ forloop.index0 | times: 100 }}ms"
          {{ block.shopify_attributes }}
        >
          <div class="nestwell-about-values__icon-wrap">
            <span class="material-symbols-outlined nestwell-about-values__icon">{{ block.settings.icon }}</span>
          </div>
          {%- if block.settings.heading != blank -%}
            <h3 class="nestwell-about-values__card-heading">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="nestwell-about-values__card-text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "About Values",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Ethos" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Intentionally Crafted" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "eco", "label": "Eco" },
            { "value": "architecture", "label": "Architecture" },
            { "value": "local_shipping", "label": "Shipping" },
            { "value": "favorite", "label": "Favorite" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "spa", "label": "Spa" },
            { "value": "verified", "label": "Verified" },
            { "value": "handshake", "label": "Handshake" }
          ],
          "default": "eco"
        },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "About Values", "blocks": [{ "type": "value" }, { "type": "value" }, { "type": "value" }] }]
}
{% endschema %}

{% stylesheet %}
  .nestwell-about-values {
    width: 100%;
    background: #efeeec;
    padding: 120px 20px;
  }
  @media screen and (min-width: 990px) {
    .nestwell-about-values {
      padding: 120px 64px;
    }
  }
  .nestwell-about-values__intro {
    max-width: 1280px;
    margin: 0 auto 64px;
    text-align: center;
  }
  .nestwell-about-values__eyebrow {
    display: block;
    margin-bottom: 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #454842;
  }
  .nestwell-about-values__heading {
    margin: 0;
    font-family: 'EB Garamond', serif;
    font-size: 24px;
    color: #171916;
  }
  .nestwell-about-values__grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }
  @media screen and (min-width: 768px) {
    .nestwell-about-values__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 48px;
    }
  }
  .nestwell-about-values__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    padding: 32px;
  }
  .nestwell-about-values__icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    background: #e9e8e6;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(23, 25, 22, 0.05);
  }
  .nestwell-about-values__icon {
    font-size: 32px;
    color: #171916;
  }
  .nestwell-about-values__card-heading {
    margin: 0;
    font-family: 'EB Garamond', serif;
    font-size: 24px;
    color: #171916;
  }
  .nestwell-about-values__card-text {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 24px;
    color: #454842;
  }

  .observe-fade-up,
  .observe-scale-in {
    opacity: 0;
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .observe-fade-up {
    transform: translateY(24px);
  }
  .observe-scale-in {
    transform: scale(0.95);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .observe-fade-up.is-visible,
  .observe-scale-in.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .observe-fade-up,
    .observe-scale-in {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('.nestwell-about-values[data-section-id]');
    if (!section) return;

    var targets = section.querySelectorAll('.observe-fade-up, .observe-scale-in');
    if (!targets.length) return;

    if (!('IntersectionObserver' in window)) {
      targets.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries, obs) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    targets.forEach(function (el) {
      observer.observe(el);
    });
  });
{% endjavascript %}
