<section class="nestwell-about-story" id="nestwell-about-story-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="nestwell-about-story__list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'story_block' -%}
        {%- assign is_reversed = forloop.index0 | modulo: 2 -%}
        <div
          class="nestwell-about-story__row {% if is_reversed == 0 %}nestwell-about-story__row--reversed{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="nestwell-about-story__media {% if is_reversed == 0 %}observe-fade-right{% else %}observe-fade-left{% endif %}">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1200 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 600 }} 600w,
                  {{ block.settings.image | image_url: width: 900 }} 900w,
                  {{ block.settings.image | image_url: width: 1200 }} 1200w
                "
                sizes="(min-width: 990px) 50vw, 100vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                class="nestwell-about-story__img"
              >
            {%- endif -%}
          </div>
          <div class="nestwell-about-story__content {% if is_reversed == 0 %}observe-fade-left{% else %}observe-fade-right{% endif %}">
            {%- if block.settings.heading != blank -%}
              <h2 class="nestwell-about-story__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="nestwell-about-story__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "About Story",
  "blocks": [
    {
      "type": "story_block",
      "name": "Story block",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "About Story", "blocks": [{ "type": "story_block" }, { "type": "story_block" }] }]
}
{% endschema %}

{% stylesheet %}
  .nestwell-about-story {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 120px 20px;
  }
  @media screen and (min-width: 990px) {
    .nestwell-about-story {
      padding: 120px 64px;
    }
    .nestwell-about-story__row--reversed .nestwell-about-story__media {
      order: 2;
    }
    .nestwell-about-story__row--reversed .nestwell-about-story__content {
      order: 1;
    }
  }
  .nestwell-about-story__list {
    display: flex;
    flex-direction: column;
    gap: 128px;
  }
  .nestwell-about-story__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  @media screen and (min-width: 990px) {
    .nestwell-about-story__row {
      grid-template-columns: 1fr 1fr;
      gap: 96px;
    }
  }
  .nestwell-about-story__media {
    width: 100%;
    height: 420px;
    overflow: hidden;
  }
  @media screen and (min-width: 990px) {
    .nestwell-about-story__media {
      height: 600px;
    }
  }
  .nestwell-about-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nestwell-about-story__heading {
    margin: 0 0 24px;
    font-family: 'EB Garamond', serif;
    font-size: 32px;
    line-height: 40px;
    color: #171916;
  }
  .nestwell-about-story__text {
    margin: 0;
    max-width: 42rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    line-height: 28px;
    color: #454842;
  }

  .observe-fade-up,
  .observe-fade-left,
  .observe-fade-right,
  .observe-scale-in {
    opacity: 0;
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .observe-fade-up {
    transform: translateY(24px);
  }
  .observe-fade-left {
    transform: translateX(-48px);
  }
  .observe-fade-right {
    transform: translateX(48px);
  }
  .observe-scale-in {
    transform: scale(0.95);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .observe-fade-up.is-visible,
  .observe-fade-left.is-visible,
  .observe-fade-right.is-visible,
  .observe-scale-in.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .observe-fade-up,
    .observe-fade-left,
    .observe-fade-right,
    .observe-scale-in {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('.nestwell-about-story[data-section-id]');
    if (!section) return;

    var targets = section.querySelectorAll(
      '.observe-fade-up, .observe-fade-left, .observe-fade-right, .observe-scale-in'
    );
    if (!targets.length) return;

    if (!('IntersectionObserver' in window)) {
      targets.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries, obs) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    targets.forEach(function (el) {
      observer.observe(el);
    });
  });
{% endjavascript %}
