<footer class="nestwell-footer">
  <div class="nestwell-footer__container">
    <div class="nestwell-footer__grid">
      <div class="nestwell-footer__brand">
        <div>
          <h4 class="nestwell-footer__brand-name">{{ shop.name }}</h4>
          {%- if section.settings.description != blank -%}
            <p class="nestwell-footer__description">{{ section.settings.description | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="nestwell-footer__social">
            {%- for block in section.blocks -%}
              {%- if block.type == 'social' and block.settings.url != blank -%}
                <a
                  href="{{ block.settings.url }}"
                  class="nestwell-footer__social-link"
                  aria-label="                {{- block.settings.platform | capitalize -}}"
                  target="_blank"
                  rel="noopener"
                  {{ block.shopify_attributes }}
                >
                  {%- case block.settings.platform -%}
                    {%- when 'facebook' -%}
                      <svg
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.02 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.522 1.492-3.915 3.777-3.915 1.094 0 2.238.196 2.238.196v2.474h-1.26c-1.243 0-1.63.775-1.63 1.57v1.89h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.92 8.437-9.94z"/>
                      </svg>

                    {%- when 'instagram' -%}
                      <svg
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M12 2c-2.72 0-3.06.012-4.123.06-1.062.05-1.79.218-2.425.465a4.897 4.897 0 0 0-1.771 1.153A4.897 4.897 0 0 0 2.525 5.45c-.247.636-.416 1.363-.465 2.425C2.012 8.938 2 9.28 2 12s.012 3.062.06 4.125c.05 1.062.218 1.789.465 2.424a4.897 4.897 0 0 0 1.153 1.772 4.883 4.883 0 0 0 1.771 1.153c.636.247 1.363.416 2.425.465C8.938 21.988 9.28 22 12 22s3.062-.012 4.125-.06c1.062-.05 1.789-.219 2.424-.466a4.883 4.883 0 0 0 1.772-1.153 4.897 4.897 0 0 0 1.153-1.772c.247-.635.416-1.362.465-2.424C21.988 15.062 22 14.72 22 12s-.012-3.062-.06-4.125c-.05-1.062-.219-1.789-.466-2.425a4.897 4.897 0 0 0-1.153-1.771 4.89 4.89 0 0 0-1.772-1.153c-.635-.247-1.362-.416-2.424-.465C15.062 2.012 14.72 2 12 2zm0 1.802c2.674 0 2.99.01 4.042.059.976.044 1.505.207 1.858.344.467.181.8.398 1.15.748.35.35.566.683.747 1.15.137.353.3.882.344 1.858.048 1.053.058 1.369.058 4.039 0 2.67-.01 2.986-.058 4.038-.044.977-.207 1.505-.344 1.858a3.1 3.1 0 0 1-.748 1.15 3.098 3.098 0 0 1-1.15.746c-.352.138-.881.3-1.857.345-1.054.048-1.37.058-4.043.058-2.673 0-2.989-.01-4.042-.058-.976-.045-1.505-.207-1.858-.345a3.09 3.09 0 0 1-1.15-.747 3.1 3.1 0 0 1-.748-1.15c-.137-.352-.3-.88-.344-1.857-.048-1.053-.058-1.369-.058-4.04 0-2.67.01-2.985.058-4.038.044-.976.207-1.505.344-1.857.18-.468.397-.8.748-1.15a3.099 3.099 0 0 1 1.15-.748c.352-.137.881-.3 1.858-.344 1.052-.048 1.368-.059 4.041-.059zM12 7.297a4.703 4.703 0 1 0 0 9.406 4.703 4.703 0 0 0 0-9.406zM12 15a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm5.884-9.207a1.099 1.099 0 1 1-2.198 0 1.099 1.099 0 0 1 2.198 0z"/>
                      </svg>
                    
                      
                    {%- when 'pinterest' -%}
                      <svg
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M12 2C6.477 2 2 6.477 2 12c0 4.237 2.636 7.855 6.356 9.312-.088-.791-.167-2.005.035-2.868.182-.78 1.172-4.97 1.172-4.97s-.299-.6-.299-1.486c0-1.39.806-2.428 1.81-2.428.852 0 1.264.64 1.264 1.408 0 .858-.546 2.14-.828 3.33-.236.996.5 1.807 1.48 1.807 1.778 0 3.144-1.874 3.144-4.58 0-2.393-1.72-4.068-4.177-4.068-2.845 0-4.515 2.135-4.515 4.34 0 .859.331 1.781.744 2.281a.3.3 0 0 1 .069.288c-.076.316-.245.996-.278 1.135-.043.183-.144.222-.332.134-1.24-.577-2.014-2.389-2.014-3.845 0-3.131 2.275-6.008 6.559-6.008 3.444 0 6.121 2.454 6.121 5.734 0 3.421-2.157 6.174-5.153 6.174-1.006 0-1.951-.523-2.274-1.14l-.618 2.357c-.224.862-.83 1.941-1.235 2.6.93.288 1.918.443 2.943.443 5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                      </svg>
                    {%- when 'tiktok' -%}
                      <svg
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M16.6 5.82c-.981-.98-1.6-2.245-1.6-3.82h-3.34v13.7c0 1.646-1.33 2.987-2.97 2.987a2.98 2.98 0 0 1-2.98-2.987 2.98 2.98 0 0 1 2.98-2.987c.312 0 .61.05.892.14V9.4a6.32 6.32 0 0 0-.892-.064A6.32 6.32 0 0 0 2.4 15.66a6.32 6.32 0 0 0 6.29 6.324 6.32 6.32 0 0 0 6.29-6.324V9.03a9.3 9.3 0 0 0 4.62 1.226V6.916a5.85 5.85 0 0 1-2.99-1.094z"/>
                      </svg>
                    {%- when 'twitter' -%}
                      <svg
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                      </svg>
                    {%- when 'youtube' -%}
                      <svg
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12z"/>
                      </svg>
                  {%- endcase -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.footer_menu != blank -%}
        {%- for link in section.settings.footer_menu.links -%}
          {%- if link.links != blank -%}
            <div class="nestwell-footer__nav-col">
              <h5 class="nestwell-footer__col-heading">{{ link.title | escape }}</h5>
              <nav class="nestwell-footer__nav">
                {%- for child_link in link.links -%}
                  <a href="{{ child_link.url }}" class="nestwell-footer__nav-link">{{ child_link.title | escape }}</a>
                {%- endfor -%}
              </nav>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      <div class="nestwell-footer__newsletter-col">
        {%- if section.settings.newsletter_heading != blank -%}
          <h5 class="nestwell-footer__col-heading">{{ section.settings.newsletter_heading | escape }}</h5>
        {%- endif -%}
        {%- if section.settings.newsletter_text != blank -%}
          <p class="nestwell-footer__newsletter-text">{{ section.settings.newsletter_text | escape }}</p>
        {%- endif -%}

        {%- form 'customer', id: 'NestwellFooterNewsletter', class: 'nestwell-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="nestwell-footer__newsletter-input-wrap">
            <label for="NestwellNewsletterEmail-{{ section.id }}" class="visually-hidden">Email</label>
            <input
              id="NestwellNewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="nestwell-footer__newsletter-input"
              value="{% if customer %}{{ customer.email }}{% endif %}"
              placeholder="Your email"
              autocomplete="email"
              required
            >
            <button type="submit" class="nestwell-footer__newsletter-submit" aria-label="Subscribe">
              <span>
                {% render 'icon-arrow-forward' %}
              </span>
            </button>
          </div>
          {%- if form.errors -%}
            <p class="nestwell-footer__newsletter-message nestwell-footer__newsletter-message--error">
              {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="nestwell-footer__newsletter-message nestwell-footer__newsletter-message--success">
              Thanks for subscribing!
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <div class="nestwell-footer__bottom">
      <span class="nestwell-footer__copyright"
        >&copy; {{ 'now' | date: '%Y' }}
        {{ shop.name }}. All rights reserved.</span
      >
      <div class="nestwell-footer__legal">
        {%- if shop.policies.privacy_policy.url != blank -%}
          <a href="{{ shop.policies.privacy_policy.url }}" class="nestwell-footer__legal-link">
            {{- shop.policies.privacy_policy.title -}}
          </a>
        {%- endif -%}
        {%- if shop.policies.terms_of_service.url != blank -%}
          <a href="{{ shop.policies.terms_of_service.url }}" class="nestwell-footer__legal-link">
            {{- shop.policies.terms_of_service.title -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Nestwell Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Crafting sanctuaries of serenity and tactile luxury for the modern home."
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer menu",
      "info": "Top-level menu items become column headers. Add dropdown items under each to populate that column's links."
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Newsletter"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Join our circle for exclusive early access and interior inspiration."
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            { "value": "facebook", "label": "Facebook" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "pinterest", "label": "Pinterest" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "twitter", "label": "Twitter / X" },
            { "value": "youtube", "label": "YouTube" }
          ],
          "default": "instagram"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Nestwell Footer",
      "blocks": [{ "type": "social" }, { "type": "social" }, { "type": "social" }]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .nestwell-footer {
    width: 100%;
    background: #f4f3f1;
    border-top: 1px solid #c6c7c0;
    margin-top: 120px;
    padding: 120px 20px;
  }

  @media screen and (min-width: 990px) {
    .nestwell-footer {
      padding-left: 64px;
      padding-right: 64px;
    }
  }

  .nestwell-footer__container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .nestwell-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media screen and (min-width: 750px) {
    .nestwell-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .nestwell-footer__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  .nestwell-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .nestwell-footer__brand-name {
    margin: 0 0 16px;
    font-family: 'EB Garamond', serif;
    font-size: 24px;
    line-height: 32px;
    font-weight: 500;
    color: #171916;
  }

  .nestwell-footer__description {
    max-width: 20rem;
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    color: #454842;
  }

  .nestwell-footer__social {
    display: flex;
    gap: 16px;
  }

  .nestwell-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: #454842;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nestwell-footer__social-link:hover {
    color: #171916;
  }

  .nestwell-footer__social-link svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .nestwell-footer__col-heading {
    margin: 0 0 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #171916;
  }

  .nestwell-footer__nav-col {
    display: flex;
    flex-direction: column;
  }

  .nestwell-footer__nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .nestwell-footer__nav-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    color: #454842;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nestwell-footer__nav-link:hover {
    color: #171916;
  }

  .nestwell-footer__newsletter-col {
    display: flex;
    flex-direction: column;
  }

  .nestwell-footer__newsletter-text {
    margin: 0 0 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    color: #454842;
  }

  .nestwell-footer__newsletter-form {
    width: 100%;
  }

  .nestwell-footer__newsletter-input-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid #454842;
    padding: 8px 0;
  }

  .nestwell-footer__newsletter-input {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 24px;
    color: #171916;
  }

  .nestwell-footer__newsletter-input::placeholder {
    color: rgba(69, 72, 66, 0.5);
  }

  .nestwell-footer__newsletter-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: #171916;
    padding: 0;
  }

  .nestwell-footer__newsletter-submit .material-symbols-outlined {
    font-size: 20px;
  }

  .nestwell-footer__newsletter-message {
    margin: 8px 0 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    line-height: 20px;
  }

  .nestwell-footer__newsletter-message--error {
    color: #ba1a1a;
  }

  .nestwell-footer__newsletter-message--success {
    color: #454842;
  }

  .nestwell-footer__bottom {
    margin-top: 80px;
    padding-top: 32px;
    border-top: 1px solid #c6c7c0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: rgba(69, 72, 66, 0.6);
  }

  @media screen and (min-width: 750px) {
    .nestwell-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .nestwell-footer__legal {
    display: flex;
    gap: 24px;
  }

  .nestwell-footer__legal-link {
    color: inherit;
    text-decoration: none;
  }

  .nestwell-footer__legal-link:hover {
    color: #171916;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
{% endstylesheet %}
