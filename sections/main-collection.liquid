<div class="nestwell-collection" data-section-id="{{ section.id }}">
  <div class="nestwell-collection__header">
    <nav aria-label="Breadcrumb" class="nestwell-collection__breadcrumb">
      <ol class="nestwell-collection__breadcrumb-list">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li>
          <span class="nestwell-collection__breadcrumb-chevron">{% render 'icon-chevron-right' %}</span>
        </li>
        <li><a href="{{ routes.collections_url }}">Shop</a></li>
        <li>
          <span class="nestwell-collection__breadcrumb-chevron">{% render 'icon-chevron-right' %}</span>
        </li>
        <li aria-current="page" class="nestwell-collection__breadcrumb-current">{{ collection.title }}</li>
      </ol>
    </nav>

    <div class="nestwell-collection__title-row">
      <div class="nestwell-collection__title-text">
        <h1 class="nestwell-collection__title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <div class="nestwell-collection__description">{{ collection.description }}</div>
        {%- endif -%}
      </div>
      <div class="nestwell-collection__count">{{ collection.products_count }} Items</div>
    </div>
  </div>

  <div class="nestwell-collection__body">
    <aside class="nestwell-collection__sidebar">
      <div class="nestwell-collection__sidebar-inner">
        {%- if collection.filters.size > 0 -%}
          <form
            id="CollectionFilterForm-{{ section.id }}"
            class="nestwell-collection__filter-form"
            method="get"
            action="{{ collection.url }}"
          >
            <div class="nestwell-collection__filter-top">
              <span class="nestwell-collection__filter-label">Filters</span>
              <a href="{{ collection.url }}" class="nestwell-collection__clear-all">Clear All</a>
            </div>

            {%- for filter in collection.filters -%}
              <div class="nestwell-collection__filter-group">
                <button
                  type="button"
                  class="nestwell-collection__filter-toggle"
                  aria-expanded="true"
                  data-filter-toggle
                >
                  <span class="nestwell-collection__filter-name">{{ filter.label }}</span>
                  <span class="material-symbols-outlined nestwell-collection__filter-icon">remove</span>
                </button>

                <div class="nestwell-collection__filter-content" data-filter-content>
                  {%- case filter.type -%}
                    {%- when 'list' -%}
                      {%- for value in filter.values -%}
                        <label class="nestwell-collection__filter-option{% if value.count == 0 and value.active == false %} nestwell-collection__filter-option--disabled{% endif %}">
                          <input
                            type="checkbox"
                            class="nestwell-collection__filter-checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}
                              checked
                            {% endif %}
                            {% if value.count == 0 and value.active == false %}
                              disabled
                            {% endif %}
                          >
                          <span class="nestwell-collection__filter-check-box">
                            <span class="material-symbols-outlined nestwell-collection__filter-check-icon">check</span>
                          </span>
                          <span class="nestwell-collection__filter-option-label">
                            {{ value.label }} ({{ value.count }})
                          </span>
                        </label>
                      {%- endfor -%}

                    {%- when 'price_range' -%}
                      <div class="nestwell-collection__price-range">
                        <label class="nestwell-collection__price-input-wrap">
                          <span class="nestwell-collection__price-input-prefix">$</span>
                          <input
                            type="number"
                            class="nestwell-collection__price-input"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ filter.min_value.value }}"
                            placeholder="{{ filter.range_min | money_without_currency }}"
                            min="0"
                          >
                        </label>
                        <span class="nestwell-collection__price-sep">–</span>
                        <label class="nestwell-collection__price-input-wrap">
                          <span class="nestwell-collection__price-input-prefix">$</span>
                          <input
                            type="number"
                            class="nestwell-collection__price-input"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ filter.max_value.value }}"
                            placeholder="{{ filter.range_max | money_without_currency }}"
                            min="0"
                          >
                        </label>
                      </div>

                    {%- when 'boolean' -%}
                      {%- for value in filter.values -%}
                        <label class="nestwell-collection__filter-option">
                          <input
                            type="checkbox"
                            class="nestwell-collection__filter-checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}
                              checked
                            {% endif %}
                          >
                          <span class="nestwell-collection__filter-check-box">
                            <span class="material-symbols-outlined nestwell-collection__filter-check-icon">check</span>
                          </span>
                          <span class="nestwell-collection__filter-option-label">{{ filter.label }}</span>
                        </label>
                      {%- endfor -%}
                  {%- endcase -%}
                </div>
              </div>
            {%- endfor -%}

            <input type="hidden" name="sort_by" value="{{ collection.sort_by }}" data-sort-hidden-input>
            <button type="submit" class="nestwell-collection__filter-apply" data-filter-apply>Apply Filters</button>
          </form>
        {%- endif -%}
      </div>
    </aside>

    <div class="nestwell-collection__main">
      <div class="nestwell-collection__toolbar">
        <div class="nestwell-collection__sort" data-sort-dropdown>
          <button type="button" class="nestwell-collection__sort-toggle" data-sort-toggle aria-expanded="false">
            <span
              >Sort by:
              {{
                collection.sort_options
                | where: 'value', collection.sort_by
                | map: 'name'
                | first
                | default: 'Featured'
              -}}
            </span>
            <span class="nestwell-collection__sort-icon">{% render 'icon-keyboard-arrow-down' %}</span>
          </button>
          <div class="nestwell-collection__sort-menu" data-sort-menu>
            {%- for option in collection.sort_options -%}
              <button
                type="button"
                class="nestwell-collection__sort-option{% if option.value == collection.sort_by %} nestwell-collection__sort-option--active{% endif %}"
                data-sort-value="{{ option.value }}"
              >
                {{ option.name }}
              </button>
            {%- endfor -%}
          </div>
        </div>
      </div>

      {%- paginate collection.products by 12 -%}
        {%- if collection.products.size > 0 -%}
          <div class="nestwell-collection__grid" id="product-grid-{{ section.id }}">
            {%- for product in collection.products -%}
              <div
                class="nestwell-collection__grid-item observe-fade-up"
                style="transition-delay: {{ forloop.index0 | modulo: 4 | times: 100 }}ms;"
              >
                {%- render 'product-card', product: product -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="nestwell-collection__pagination">
              {%- if paginate.next -%}
                <a
                  href="{{ paginate.next.url }}"
                  class="nestwell-collection__load-more"
                  data-load-more
                  data-next-url="{{ paginate.next.url }}"
                >
                  <span>Load More</span>
                  <span class="material-symbols-outlined nestwell-collection__load-more-icon">expand_more</span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="nestwell-collection__empty">
            <p>No products found matching your selection.</p>
            <a href="{{ collection.url }}" class="nestwell-collection__clear-all">Clear filters</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

<div
  class="nestwell-collection__toast-container"
  id="toast-container-{{ section.id }}"
  data-section-id="{{ section.id }}"
  aria-live="polite"
></div>

{% schema %}
{
  "name": "Nestwell Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Nestwell Collection"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .nestwell-collection {
    width: 100%;
  }

  .nestwell-collection__header {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 20px 24px;
  }

  @media screen and (min-width: 990px) {
    .nestwell-collection__header {
      padding-left: 64px;
      padding-right: 64px;
    }
  }

  .nestwell-collection__breadcrumb {
    margin-bottom: 32px;
  }

  .nestwell-collection__breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #454842;
  }

  .nestwell-collection__breadcrumb-list a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nestwell-collection__breadcrumb-list a:hover {
    color: #171916;
  }

  .nestwell-collection__breadcrumb-chevron {
    font-size: 16px;
    line-height: 1;
  }

  .nestwell-collection__breadcrumb-current {
    color: #171916;
    font-weight: 600;
  }

  .nestwell-collection__title-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 48px;
  }

  @media screen and (min-width: 750px) {
    .nestwell-collection__title-row {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .nestwell-collection__title-text {
    max-width: 70rem;
  }

  .nestwell-collection__title {
    margin: 0 0 16px;
    font-family: 'EB Garamond', serif;
    font-size: 40px;
    line-height: 48px;
    font-weight: 400;
    color: #171916;
  }

  @media screen and (min-width: 750px) {
    .nestwell-collection__title {
      font-size: 64px;
      line-height: 72px;
      letter-spacing: -0.02em;
    }
  }

  .nestwell-collection__description {
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    line-height: 28px;
    font-weight: 400;
    color: #454842;
  }

  .nestwell-collection__count {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #454842;
    white-space: nowrap;
  }

  .nestwell-collection__body {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px 120px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media screen and (min-width: 990px) {
    .nestwell-collection__body {
      padding-left: 64px;
      padding-right: 64px;
      flex-direction: row;
    }
  }

  .nestwell-collection__sidebar {
    width: 100%;
    flex-shrink: 0;
  }

  @media screen and (min-width: 990px) {
    .nestwell-collection__sidebar {
      width: 256px;
    }
  }

  .nestwell-collection__sidebar-inner {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .nestwell-collection__filter-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(198, 199, 192, 0.3);
    padding-bottom: 16px;
  }

  .nestwell-collection__filter-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #171916;
  }

  .nestwell-collection__clear-all {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #454842;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .nestwell-collection__clear-all:hover {
    color: #171916;
  }

  .nestwell-collection__filter-group {
    padding-top: 24px;
  }

  .nestwell-collection__filter-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 0;
  }

  .nestwell-collection__filter-name {
    font-family: 'EB Garamond', serif;
    font-size: 20px;
    line-height: 28px;
    color: #171916;
  }

  .nestwell-collection__filter-icon {
    color: #171916;
    transition: transform 0.3s ease;
  }

  .nestwell-collection__filter-content {
    overflow: hidden;
    max-height: 500px;
    opacity: 1;
    margin-top: 16px;
    transition: max-height 0.3s ease, opacity 0.3s ease, margin-top 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .nestwell-collection__filter-option {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
  }

  .nestwell-collection__filter-option--disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .nestwell-collection__filter-checkbox {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nestwell-collection__filter-check-box {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    border: 1px solid #c6c7c0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .nestwell-collection__filter-checkbox:checked + .nestwell-collection__filter-check-box {
    background: #171916;
    border-color: #171916;
  }

  .nestwell-collection__filter-check-icon {
    font-size: 12px;
    color: #ffffff;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .nestwell-collection__filter-checkbox:checked
    + .nestwell-collection__filter-check-box
    .nestwell-collection__filter-check-icon {
    opacity: 1;
  }

  .nestwell-collection__filter-option-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 24px;
    color: #454842;
    transition: color 0.2s ease;
  }

  .nestwell-collection__filter-option:hover .nestwell-collection__filter-option-label {
    color: #171916;
  }

  .nestwell-collection__price-range {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nestwell-collection__price-input-wrap {
    display: flex;
    align-items: center;
    gap: 4px;
    border: 1px solid #c6c7c0;
    padding: 6px 10px;
  }

  .nestwell-collection__price-input {
    width: 60px;
    border: none;
    outline: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: #171916;
  }

  .nestwell-collection__price-input-prefix {
    font-size: 14px;
    color: #454842;
  }

  .nestwell-collection__price-sep {
    color: #454842;
  }

  .nestwell-collection__filter-apply {
    margin-top: 8px;
    width: 100%;
    background: #171916;
    color: #ffffff;
    border: none;
    padding: 14px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .nestwell-collection__filter-apply:hover {
    background: #454842;
  }

  .nestwell-collection__main {
    flex: 1;
    min-width: 0;
  }

  .nestwell-collection__toolbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 24px;
  }

  .nestwell-collection__sort {
    position: relative;
  }

  .nestwell-collection__sort-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    color: #454842;
    transition: color 0.2s ease;
  }

  .nestwell-collection__sort-toggle:hover {
    color: #171916;
  }

  .nestwell-collection__sort-icon {
    font-size: 20px;
  }

  .nestwell-collection__sort-menu {
    position: absolute;
    right: 0;
    top: 100%;
    margin-top: 8px;
    width: 200px;
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    padding: 8px 0;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }

  .nestwell-collection__sort[data-open='true'] .nestwell-collection__sort-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nestwell-collection__sort-option {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    color: #454842;
    transition: background-color 0.2s ease;
  }

  .nestwell-collection__sort-option:hover {
    background: #f4f3f1;
  }

  .nestwell-collection__sort-option--active {
    color: #171916;
    font-weight: 600;
    background: #f4f3f1;
  }

  .nestwell-collection__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px 24px;
  }

  @media screen and (min-width: 600px) {
    .nestwell-collection__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .nestwell-collection__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 1200px) {
    .nestwell-collection__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .nestwell-collection__pagination {
    display: flex;
    justify-content: center;
    margin-top: 80px;
  }

  .nestwell-collection__load-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #171916;
    color: #171916;
    background: transparent;
    padding: 16px 40px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .nestwell-collection__load-more:hover {
    background: #171916;
    color: #ffffff;
  }

  .nestwell-collection__load-more[data-loading='true'] {
    opacity: 0.5;
    pointer-events: none;
  }

  .nestwell-collection__empty {
    text-align: center;
    padding: 80px 20px;
    font-family: 'DM Sans', sans-serif;
    color: #454842;
  }

  .nestwell-collection__toast-container {
    position: fixed;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
  }

  .nestwell-collection__toast {
    background: #5a614f;
    color: #ffffff;
    padding: 12px 24px;
    border-radius: 999px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    transform: translateY(24px);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .nestwell-collection__toast--visible {
    transform: translateY(0);
    opacity: 1;
  }

  .observe-fade-up {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .observe-fade-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .observe-fade-up {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }

  .product-card {
    display: flex;
    flex-direction: column;
  }

  .product-card__media-wrap {
    position: relative;
    aspect-ratio: 3 / 4;
    background: #f4f3f1;
    margin-bottom: 16px;
    overflow: hidden;
  }

  .product-card__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card__img--primary {
    z-index: 10;
    transition: opacity 0.5s ease;
  }

  .product-card__img--hover {
    z-index: 0;
  }

  .product-card:hover .product-card__img--primary {
    opacity: 0;
  }

  .product-card__img--placeholder {
    position: absolute;
    inset: 0;
    background: #e9e8e6;
  }

  .product-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 20;
    background: #ffffff;
    padding: 4px 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #454842;
  }

  .product-card__quick-add-wrap {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
  }

  .product-card__quick-add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 140px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(4px);
    color: #171916;
    border: none;
    border-radius: 999px;
    padding: 12px 24px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s, background-color 0.3s ease, color 0.3s ease;
  }

  .product-card:hover .product-card__quick-add-btn {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .product-card__quick-add-btn:hover {
    background: #171916;
    color: #ffffff;
  }

  .product-card__quick-add-btn--soldout {
    cursor: not-allowed;
    opacity: 1;
    transform: translateY(0);
    background: rgba(255, 255, 255, 0.6);
    color: #767872;
  }

  .product-card__quick-add-btn--soldout:hover {
    background: rgba(255, 255, 255, 0.6);
