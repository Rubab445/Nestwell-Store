{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.querySelector('.nestwell-collection');
    if (!root) return;

    // Fade-in for product cards
    var fadeTargets = root.querySelectorAll('.observe-fade-up');
    if (fadeTargets.length) {
      if (!('IntersectionObserver' in window)) {
        fadeTargets.forEach(function (el) {
          el.classList.add('is-visible');
        });
      } else {
        var fadeObserver = new IntersectionObserver(
          function (entries, obs) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        fadeTargets.forEach(function (el) {
          fadeObserver.observe(el);
        });
      }
    }

    // Filter accordions
    root.querySelectorAll('[data-filter-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var content = btn.nextElementSibling;
        var icon = btn.querySelector('.material-symbols-outlined');
        var isExpanded = btn.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          btn.setAttribute('aria-expanded', 'false');
          icon.textContent = 'add';
          content.style.maxHeight = '0px';
          content.style.opacity = '0';
          content.style.marginTop = '0px';
        } else {
          btn.setAttribute('aria-expanded', 'true');
          icon.textContent = 'remove';
          content.style.maxHeight = content.scrollHeight + 'px';
          content.style.opacity = '1';
          content.style.marginTop = '16px';
        }
      });
    });

    // Auto-submit filter form on checkbox change (progressive enhancement;
    // the visible "Apply Filters" button still works with JS disabled)
    var filterForm = root.querySelector('.nestwell-collection__filter-form');
    if (filterForm) {
      filterForm.querySelectorAll('input[type="checkbox"]').forEach(function (input) {
        input.addEventListener('change', function () {
          filterForm.requestSubmit();
        });
      });
    }

    // Sort dropdown
    var sortWrap = root.querySelector('[data-sort-dropdown]');
    if (sortWrap) {
      var sortToggle = sortWrap.querySelector('[data-sort-toggle]');
      var sortHiddenInput = filterForm ? filterForm.querySelector('[data-sort-hidden-input]') : null;

      sortToggle.addEventListener('click', function () {
        var isOpen = sortWrap.getAttribute('data-open') === 'true';
        sortWrap.setAttribute('data-open', isOpen ? 'false' : 'true');
        sortToggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      });

      document.addEventListener('click', function (e) {
        if (!sortWrap.contains(e.target)) {
          sortWrap.setAttribute('data-open', 'false');
          sortToggle.setAttribute('aria-expanded', 'false');
        }
      });

      sortWrap.querySelectorAll('[data-sort-value]').forEach(function (option) {
        option.addEventListener('click', function () {
          var value = option.getAttribute('data-sort-value');
          var url = new URL(window.location.href);
          url.searchParams.set('sort_by', value);
          window.location.href = url.toString();
        });
      });
    }

    // Toast helper
    var sectionId = root.getAttribute('data-section-id');
    var toastContainer = document.querySelector(
      '.nestwell-collection__toast-container[data-section-id="' + sectionId + '"]'
    );
    function showToast(message) {
      if (!toastContainer) return;
      var toast = document.createElement('div');
      toast.className = 'nestwell-collection__toast';
      toast.innerHTML =
        '<span class="material-symbols-outlined" style="font-size:16px;">check_circle</span> ' + message;
      toastContainer.appendChild(toast);

      requestAnimationFrame(function () {
        toast.classList.add('nestwell-collection__toast--visible');
      });

      setTimeout(function () {
        toast.classList.remove('nestwell-collection__toast--visible');
        setTimeout(function () {
          toast.remove();
        }, 300);
      }, 3000);
    }

    // Quick add — real AJAX add to cart (delegated on root so it also
    // works for product cards appended later via Load More)
    root.addEventListener('submit', function (e) {
      var form = e.target.closest('.product-card__quick-add-form');
      if (!form) return;
      e.preventDefault();

      var btn = form.querySelector('[data-quick-add-btn]');
      var textSpan = btn.querySelector('.product-card__quick-add-text');
      var iconSpan = btn.querySelector('.product-card__quick-add-icon');
      var productTitle = form.closest('.product-card').querySelector('.product-card__title').textContent.trim();

      fetch(window.routes ? window.routes.cart_add_url : '/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          items: [{ id: form.querySelector('[name="id"]').value, quantity: 1 }],
        }),
      })
        .then(function (response) {
          return response.json();
        })
        .then(function (data) {
          if (data.status) {
            showToast(data.description || 'Could not add to cart');
            return;
          }
          textSpan.hidden = true;
          iconSpan.hidden = false;
          showToast('Added ' + productTitle + ' to cart');
          document.dispatchEvent(new CustomEvent('cart:updated'));

          setTimeout(function () {
            textSpan.hidden = false;
            iconSpan.hidden = true;
          }, 2000);
        })
        .catch(function () {
          showToast('Something went wrong. Please try again.');
        });
    });

    // Load more — real pagination link, AJAX-enhanced to append instead of navigating
    var loadMoreBtn = root.querySelector('[data-load-more]');
    var grid = root.querySelector('.nestwell-collection__grid');

    if (loadMoreBtn && grid) {
      loadMoreBtn.addEventListener('click', function (e) {
        e.preventDefault();
        var nextUrl = loadMoreBtn.getAttribute('data-next-url');
        if (!nextUrl) return;

        loadMoreBtn.setAttribute('data-loading', 'true');

        fetch(nextUrl)
          .then(function (response) {
            return response.text();
          })
          .then(function (html) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, 'text/html');
            var newGrid = doc.querySelector('.nestwell-collection__grid');
            var newLoadMore = doc.querySelector('[data-load-more]');

            if (newGrid) {
              Array.from(newGrid.children).forEach(function (card) {
                card.classList.remove('is-visible');
                grid.appendChild(card);
                var fadeObserver = new IntersectionObserver(
                  function (entries, obs) {
                    entries.forEach(function (entry) {
                      if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        obs.unobserve(entry.target);
                      }
                    });
                  },
                  { threshold: 0.1 }
                );
                fadeObserver.observe(card);
              });
            }

            if (newLoadMore) {
              loadMoreBtn.setAttribute('data-next-url', newLoadMore.getAttribute('data-next-url'));
              loadMoreBtn.setAttribute('href', newLoadMore.getAttribute('href'));
            } else {
              loadMoreBtn.remove();
            }

            loadMoreBtn.removeAttribute('data-loading');
          })
          .catch(function () {
            window.location.href = nextUrl;
          });
      });
    }
  });
{% endjavascript %}
