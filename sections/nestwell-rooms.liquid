<section class="nestwell-rooms">
  <div class="nestwell-rooms__container">
    <div class="nestwell-rooms__header">
      <div class="nestwell-rooms__header-text">
        {%- if section.settings.heading != blank -%}
          <h2 class="nestwell-rooms__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="nestwell-rooms__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <a href="{{ section.settings.link_url }}" class="nestwell-rooms__header-link">
          {{ section.settings.link_label | escape }}
          <span class="material-symbols-outlined nestwell-rooms__header-link-icon">arrow_outward</span>
        </a>
      {%- endif -%}
    </div>

    <div class="nestwell-rooms__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'room' -%}
         <a href="{{ block.settings.link | default: '#' }}" class="nestwell-rooms__item observe-fade-up"
          style="transition-delay: {{ forloop.index0 | times: 100 }}ms;"
          {{ block.shopify_attributes }}
          >
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              srcset="
                {{ block.settings.image | image_url: width: 400 }} 400w,
                {{ block.settings.image | image_url: width: 600 }} 600w,
                {{ block.settings.image | image_url: width: 800 }} 800w
              "
              sizes="(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              alt="{{ block.settings.title | escape }}"
              class="nestwell-rooms__item-img"
            >
          {%- endif -%}
          <div class="nestwell-rooms__item-overlay"></div>
          <div class="nestwell-rooms__item-content">
            {%- if block.settings.title != blank -%}
              <h3 class="nestwell-rooms__item-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            <span class="material-symbols-outlined nestwell-rooms__item-arrow">{% render 'arrow-forward' %}</span>
          </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nestwell Shop by Room",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curate Your Space"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Thoughtfully designed pieces tailored for every room in your sanctuary."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop All Rooms"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Room image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Room name",
          "default": "Living Room"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Nestwell Shop by Room",
      "blocks": [{ "type": "room" }, { "type": "room" }, { "type": "room" }, { "type": "room" }]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .nestwell-rooms {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 120px 20px;
  }

  @media screen and (min-width: 990px) {
    .nestwell-rooms {
      padding-left: 64px;
      padding-right: 64px;
    }
  }

  .nestwell-rooms__container {
    width: 100%;
  }

  .nestwell-rooms__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 64px;
  }

  @media screen and (min-width: 750px) {
    .nestwell-rooms__header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .nestwell-rooms__title {
    margin: 0 0 16px;
    font-family: 'EB Garamond', serif;
    font-size: 32px;
    line-height: 40px;
    font-weight: 400;
    color: #171916;
  }

  .nestwell-rooms__subtitle {
    max-width: 28rem;
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    color: #454842;
  }

  .nestwell-rooms__header-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding-bottom: 4px;
    border-bottom: 1px solid #171916;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #171916;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }

  @media screen and (min-width: 750px) {
    .nestwell-rooms__header-link {
      margin-top: 0;
    }
  }

  .nestwell-rooms__header-link:hover {
    color: #454842;
    border-color: #454842;
  }

  .nestwell-rooms__header-link-icon {
    font-size: 16px;
  }

  .nestwell-rooms__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .nestwell-rooms__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .nestwell-rooms__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .nestwell-rooms__item {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #e9e8e6;
    text-decoration: none;
  }

  /* Decorative offset only — purely visual, not merchant-configurable */
  @media screen and (min-width: 990px) {
    .nestwell-rooms__item:nth-child(2) {
      margin-top: -32px;
    }
  }

  .nestwell-rooms__item-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease-out;
  }

  .nestwell-rooms__item:hover .nestwell-rooms__item-img {
    transform: scale(1.1);
  }

  .nestwell-rooms__item-overlay {
    position: absolute;
    inset: 0;
    background: rgba(23, 25, 22, 0.2);
    transition: background-color 0.5s ease;
  }

  .nestwell-rooms__item:hover .nestwell-rooms__item-overlay {
    background: rgba(23, 25, 22, 0.4);
  }

  .nestwell-rooms__item-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32px;
  }

  .nestwell-rooms__item-title {
    margin: 0;
    font-family: 'EB Garamond', serif;
    font-size: 24px;
    line-height: 32px;
    font-weight: 500;
    color: #ffffff;
  }

  .nestwell-rooms__item-arrow {
    color: #ffffff;
    opacity: 0;
    transform: translateX(-1rem);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .nestwell-rooms__item:hover .nestwell-rooms__item-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Fade-up on scroll, staggered via inline transition-delay per block index */
  .observe-fade-up {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .observe-fade-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .nestwell-rooms__item-img,
    .nestwell-rooms__item-overlay,
    .nestwell-rooms__item-arrow,
    .nestwell-rooms__header-link,
    .observe-fade-up {
      transition: none;
    }
    .observe-fade-up {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var targets = document.querySelectorAll('.nestwell-rooms .observe-fade-up');
    if (!targets.length) return;

    if (!('IntersectionObserver' in window)) {
      targets.forEach(function (el) {
        el.classList.add('is-visible');
      });
      return;
    }

    var observer = new IntersectionObserver(
      function (entries, obs) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    targets.forEach(function (el) {
      observer.observe(el);
    });
  });
{% endjavascript %}
