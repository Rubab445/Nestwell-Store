<section class="nestwell-rooms">
  <div class="nestwell-rooms__container">
    <div class="nestwell-rooms__header">
      <div class="nestwell-rooms__header-text">
        {%- if section.settings.heading != blank -%}
          <h2 class="nestwell-rooms__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="nestwell-rooms__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <a href="{{ section.settings.link_url }}" class="nestwell-rooms__header-link">
          {{ section.settings.link_label | escape }}
          <span class="material-symbols-outlined nestwell-rooms__header-link-icon">arrow_outward</span>
        </a>
      {%- endif -%}
    </div>

    <div class="nestwell-rooms__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'room' -%}
          href="{{ block.settings.link | default: '#' }}" class="nestwell-rooms__item
          {%- cycle 'nestwell-rooms__item--offset', '', '', 'nestwell-rooms__item--offset', '', '' -%}
          "
          {{ block.shopify_attributes }}
          >
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              srcset="
                {{ block.settings.image | image_url: width: 400 }} 400w,
                {{ block.settings.image | image_url: width: 600 }} 600w,
                {{ block.settings.image | image_url: width: 800 }} 800w
              "
              sizes="(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              alt=""
              class="nestwell-rooms__item-img"
            >
          {%- endif -%}
          <div class="nestwell-rooms__item-overlay"></div>
          <div class="nestwell-rooms__item-content">
            {%- if block.settings.title != blank -%}
              <h3 class="nestwell-rooms__item-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            <span class="material-symbols-outlined nestwell-rooms__item-arrow">east</span>
          </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nestwell Shop by Room",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curate Your Space"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Thoughtfully designed pieces tailored for every room in your sanctuary."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop All Rooms"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Room image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Room name",
          "default": "Living Room"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Nestwell Shop by Room",
      "blocks": [{ "type": "room" }, { "type": "room" }, { "type": "room" }, { "type": "room" }]
    }
  ]
}
{% endschema %}
